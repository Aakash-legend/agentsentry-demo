# Ensure shell scripts and Python files use LF line endings (needed for Linux VM)
*.sh    text eol=lf
*.py    text eol=lf
*.c     text eol=lf
*.h     text eol=lf
Makefile text eol=lf

# HTML/CSS/JS can use native line endings
*.html  text
*.css   text
*.js    text
*.md    text
*.json  text
*.txt   text
